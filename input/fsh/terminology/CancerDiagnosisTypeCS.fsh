CodeSystem: CancerDiagnosisTypeCS
Id: cancer-diagnosis-type-cs
Title: "Cancer Diagnosis Type translation in Russian and English"
Description: "Cancer diagnosis type code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-diagnosis-type-cs)

* #cancr0003.00001 "RSNPMCOvaR filiali kasallik tarixi (ambulator karta)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "История болезни (амб. Карта) филиала РСНПМЦОиР"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical record (outpatient card) of a branch of the Republican Specialized Scientific and Practical Medical Center of Oncology and Radiology"

* #cancr0003.00002 "Boshqa tibbiyot muassasasining kasallik tarixidan (ambulator kartasidan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выписка из истории болезни (амб.карты) другого медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Extract from the medical record (outpatient card) of another medical institution"

* #cancr0003.00003 "RSNPMCOvaR filiali xabarnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение филиала РСНПМЦОиР"
  * ^designation[+].language = #en
  * ^designation[=].value = "Notification from a branch of the Republican Specialized Scientific and Practical Medical Center of Oncology and Radiology"

* #cancr0003.00004 "Boshqa tibbiyot muassasasidan xabarnoma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение из другого медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Notification from another medical institution"

* #cancr0003.00005 "RMO/GMO xabarnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение РМО/ГМО"
  * ^designation[+].language = #en
  * ^designation[=].value = "RMO/GMO notification"

* #cancr0003.00006 "Bolalar onkologiyasi, gematologiyasi va immunologiyasi Respublika ilmiy-amaliy tibbiyot markazining kasallik tarixi yoki kasallik tarixidan (ambulator kartadan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "История болезни или выписка из истории болезни (амб.карта) РНПМЦ детской онкологии, гематологии и иммунологии"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical record or extract from the medical record (outpatient card) of the Republican Scientific and Practical Medical Center of Pediatric Oncology, Hematology and Immunology"

* #cancr0003.00007 "Respublika ixtisoslashtirilgan ilmiy-amaliy gematologiya tibbiyot markazi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "РСНПМЦ гематологии"
  * ^designation[+].language = #en
  * ^designation[=].value = "Republican Specialized Scientific and Practical Medical Center of Hematology"

* #cancr0003.00008 "O‘lim haqidagi guvohnoma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Свидетельство о смерти"
  * ^designation[+].language = #en
  * ^designation[=].value = "Death certificate"

* #cancr0003.00009 "FHDYO organi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "ЗАГС"
  * ^designation[+].language = #en
  * ^designation[=].value = "Civil Registry Office"

* #cancr0003.00010 "Patologoanatomik byuro"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Паталого анатомическое бюро"
  * ^designation[+].language = #en
  * ^designation[=].value = "Pathology bureau"

* #cancr0003.00011 "Xususiy tibbiyot muassasasining kasallik tarixidan (ambulator kartasidan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выписка из истории болезни (амб.карты) частного медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Extract from the medical record (outpatient card) of a private medical institution"

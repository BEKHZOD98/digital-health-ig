CodeSystem: CancerEncounterDischargeDispositionCS
Id: cancer-encounter-discharge-disposition-cs
Title: "Cancer Encounter Discharge Disposition translation in Russian and English"
Description: "Cancer encounter discharge disposition code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-encounter-discharge-disposition-cs)

* #cancr0001-00001 "Tirik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Жив"
  * ^designation[+].language = #en
  * ^designation[=].value = "Alive"

* #cancr0001-00002 "Vafot etgan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Умер"
  * ^designation[+].language = #en
  * ^designation[=].value = "Deceased"

* #cancr0001-00003 "Ko‘chib ketgan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выехал"
  * ^designation[+].language = #en
  * ^designation[=].value = "Moved away"

* #cancr0001-00004 "Tashxis tasdiqlanmadi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз не подтвердился"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis not confirmed"

* #cancr0001-00005 "Kuzatuv muddati tugaganligi sababli hisobdan chiqarilgan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Снят с учета в связи с истечением сроков наблюдения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Removed from the registry due to completion of the follow-up period"


